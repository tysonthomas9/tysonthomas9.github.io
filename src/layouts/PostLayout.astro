---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { SITE_TITLE } from '../consts';
import type { Post } from '../lib/posts';

export interface Props {
  post: Post;
}
const { post } = Astro.props;
const { title, description, date, updated, tags, hero, heroAlt } = post.data;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = hero?.src;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  image: new URL(socialImage ?? '/og-default.png', Astro.site).href,
  keywords: tags.join(', '),
  author: { '@type': 'Person', name: SITE_TITLE, url: Astro.site?.href },
  publisher: { '@type': 'Person', name: SITE_TITLE, url: Astro.site?.href },
};
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  image={socialImage}
  imageAlt={heroAlt ?? title}
  publishedTime={date}
  modifiedTime={updated}
  tags={tags}
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />

  <article class="mx-auto max-w-prose px-5 pt-14 pb-8 sm:px-0 sm:pt-20">
    <header class="mb-10">
      <p class="label flex flex-wrap items-center gap-x-3 gap-y-1">
        <FormattedDate date={date} />
        {
          updated && (
            <span>
              Updated <FormattedDate date={updated} />
            </span>
          )
        }
      </p>
      <h1
        class="mt-4 font-serif text-[clamp(2.1rem,6vw,3.3rem)] leading-[1.06] font-semibold tracking-tight text-balance"
      >
        {title}
      </h1>
      <p class="mt-4 text-[1.22rem] leading-normal text-pretty text-ink-2 italic">{description}</p>
      {
        tags.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-2" aria-label="Tags">
            {tags.map((tag) => (
              <li class="tag">{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    {
      hero && (
        <figure class="mb-10 lg:-mx-24">
          <Image
            src={hero}
            alt={heroAlt ?? ''}
            loading="eager"
            fetchpriority="high"
            class="block h-auto w-full rounded-[3px] border-[1.25px] border-ink bg-paper-raised"
          />
        </figure>
      )
    }

    <div class="post-body">
      <slot />
    </div>

    <NewsletterSignup />

    <p class="mt-10 border-t border-dashed border-rule pt-6 font-mono text-sm">
      <a href="/">← All writing</a>
    </p>
  </article>
</BaseLayout>
