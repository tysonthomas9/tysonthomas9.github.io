---
/**
 * Kit newsletter signup. A plain HTML form that posts to Kit's form endpoint
 * (no third-party script). Kit shows its own success / confirmation page.
 * Renders nothing when PUBLIC_KIT_FORM_ID is unset (a dashed placeholder in dev).
 */
export interface Props {
  heading?: string;
  blurb?: string;
}
const { heading = 'Get new posts by email', blurb = 'An occasional email when a new post goes up.' } = Astro.props;

const formId = import.meta.env.PUBLIC_KIT_FORM_ID?.trim();
const isValidId = Boolean(formId && /^\d+$/.test(formId));
const action = isValidId ? `https://app.kit.com/forms/${formId}/subscriptions` : undefined;
const inputId = `kit-email-${Math.random().toString(36).slice(2, 8)}`;
---

{
  isValidId ? (
    <section aria-labelledby={`${inputId}-heading`} class="frame my-12 p-5 sm:p-6">
      <p class="label mb-2">Newsletter</p>
      <h2 id={`${inputId}-heading`} class="font-serif text-xl font-semibold leading-snug">
        {heading}
      </h2>
      <p class="mt-1 text-ink-2">{blurb}</p>
      <form action={action} method="post" class="mt-4 flex flex-col gap-2 sm:flex-row">
        <label for={inputId} class="sr-only">
          Email address
        </label>
        <input
          id={inputId}
          type="email"
          name="email_address"
          required
          autocomplete="email"
          placeholder="you@example.com"
          class="min-w-0 flex-1 rounded-[2px] border-[1.25px] border-ink bg-paper-raised px-3 py-2 font-mono text-sm text-ink placeholder:text-ink-3"
        />
        <button
          type="submit"
          class="rounded-[2px] border-[1.25px] border-ink bg-ink px-4 py-2 font-mono text-sm font-semibold text-paper hover:bg-paper hover:text-ink"
        >
          Subscribe
        </button>
      </form>
      <p class="mt-3 font-mono text-xs text-ink-3">
        Your email goes to Kit, our newsletter service, and is only used to send new posts. Unsubscribe any time.
      </p>
    </section>
  ) : import.meta.env.DEV ? (
    <div class="my-12 rounded-[2px] border border-dashed border-rule p-4 font-mono text-xs text-ink-3">
      Newsletter form hidden: set PUBLIC_KIT_FORM_ID to show it.
    </div>
  ) : null
}
