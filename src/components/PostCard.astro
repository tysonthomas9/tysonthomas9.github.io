---
import FormattedDate from './FormattedDate.astro';
import { postUrl, type Post } from '../lib/posts';

export interface Props {
  post: Post;
  index: number;
}
const { post, index } = Astro.props;
const { title, description, date, tags, draft } = post.data;
---

<article class="frame relative grid gap-2 p-5 transition-colors hover:bg-paper-raised sm:grid-cols-[7rem_1fr] sm:gap-6 sm:p-6">
  <div class="label flex gap-3 sm:flex-col sm:gap-1">
    <span aria-hidden="true">No. {String(index).padStart(2, '0')}</span>
    <FormattedDate date={date} />
  </div>
  <div>
    <h3 class="font-serif text-xl font-semibold leading-snug sm:text-2xl">
      <a href={postUrl(post)} class="text-ink no-underline after:absolute after:inset-0 hover:underline">
        {title}
      </a>
      {draft && <span class="tag ml-2 align-middle">Draft</span>}
    </h3>
    <p class="mt-2 text-ink-2">{description}</p>
    {
      tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-2" aria-label="Tags">
          {tags.map((tag) => (
            <li class="tag">{tag}</li>
          ))}
        </ul>
      )
    }
  </div>
</article>
