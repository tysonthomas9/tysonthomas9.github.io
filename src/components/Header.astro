---
import { SITE_TITLE } from '../consts';
import ThemeToggle from './ThemeToggle';

const nav = [
  { href: '/', label: 'Writing' },
  { href: '/about/', label: 'About' },
  { href: '/rss.xml', label: 'RSS' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' || path.startsWith('/blog/') : path.startsWith(href);
---

<header class="border-b border-rule">
  <div class="mx-auto flex max-w-page flex-wrap items-center justify-between gap-x-6 gap-y-3 px-5 py-4 sm:px-8">
    <a href="/" class="group flex items-center gap-3 text-ink no-underline">
      <span
        aria-hidden="true"
        class="grid h-8 w-8 place-items-center rounded-[2px] border-[1.25px] border-ink font-mono text-xs font-semibold"
        >TT</span
      >
      <span class="font-serif text-lg font-semibold tracking-tight group-hover:underline">{SITE_TITLE}</span>
    </a>
    <nav aria-label="Main" class="flex flex-wrap items-center gap-1 sm:gap-2">
      {
        nav.map(({ href, label }) => (
          <a
            href={href}
            aria-current={isCurrent(href) ? 'page' : undefined}
            class="label rounded-[2px] px-2 py-1.5 text-ink-2 no-underline hover:text-ink hover:underline aria-[current=page]:text-ink aria-[current=page]:underline"
          >
            {label}
          </a>
        ))
      }
      <span class="ml-1"><ThemeToggle client:load /></span>
    </nav>
  </div>
</header>
